{
  "name": "@expedient/ebot-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the ebot API",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "typecheck": "tsc --noEmit",
    "test": "echo 'No tests configured yet' && exit 0",
    "lint": "echo 'No linter configured yet' && exit 0",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ebot",
    "sdk",
    "api",
    "mcp",
    "ai"
  ],
  "author": "Expedient",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chad-atexpedient/ebot.git",
    "directory": "sdk/typescript"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "tsup": "^8.0.1",
    "@types/node": "^25.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
